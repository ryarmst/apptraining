# Server
PORT=3000
SSL_PORT=443
SSL_CERT_PATH=/etc/ssl/certs/apptraining/apptraining.pem
SSL_KEY_PATH=/etc/ssl/private/apptraining/apptraining.key
SESSION_SECRET=change-me-to-a-random-string
NODE_ENV=production

# Platform domain (used for subdomain routing to exercise containers)
PLATFORM_DOMAIN=apptraining.dbg.local

# Admin credentials (used for initial seed only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-long-secure-password

# Container limits
CONTAINER_IDLE_TIMEOUT_MINUTES=15
CONTAINER_MAX_LIFETIME_HOURS=2
MAX_CONTAINERS_PER_USER=3
