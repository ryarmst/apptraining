# Copy to ~/apptraining/.env on the VPS (never commit the real file)
PORT=80
SSL_PORT=443
SSL_CERT_PATH=/etc/letsencrypt/live/labs.ryarmst.ca/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/labs.ryarmst.ca/privkey.pem
SESSION_SECRET=generate-with-openssl-rand-hex-32
NODE_ENV=production

PLATFORM_DOMAIN=labs.ryarmst.ca

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-long-secure-password

CONTAINER_IDLE_TIMEOUT_MINUTES=15
CONTAINER_MAX_LIFETIME_HOURS=2
MAX_CONTAINERS_PER_USER=3
